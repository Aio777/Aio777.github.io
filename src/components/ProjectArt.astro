---
interface Props { slug: string; large?: boolean }
const { slug, large = false } = Astro.props;
const wave = Array.from({ length: 76 }, (_, point) => {
  const envelope = Math.sin(point * .21) ** 2;
  return 8 + envelope * (24 + Math.sin(point * 1.3) ** 2 * 53);
});
---
<div class:list={['project-art', `art-${slug}`, { 'art-large': large }]} aria-hidden="true">
  <div class="art-topline mono"><span>{slug === 'tb-screening' ? 'AUDIO / SCREENING' : slug === 'parallel-computing' ? 'WORKLOADS / PARALLEL CODE' : slug === 'recola' ? 'PROPERTY / LOCATION' : slug === 'heston' ? 'PRICING / CALIBRATION' : slug === 'speech-technology' ? 'VAD / GMM' : 'ROLES / WORKFLOWS'}</span><span>↗</span></div>
  {slug === 'tb-screening' && <svg viewBox="0 0 600 310" class="art-svg"><g fill="none" stroke="currentColor" stroke-opacity=".16"><path d="M0 80h600M0 155h600M0 230h600M100 0v310M200 0v310M300 0v310M400 0v310M500 0v310"/></g><g class="art-particles">{Array.from({length: 52}, (_, index) => <circle cx={90 + Math.sin(index * 2.4) * 65 + index * 2.7} cy={155 + Math.cos(index * 1.6) * 72} r={2 + index % 3} fill="var(--accent)" opacity={.3 + index % 6 * .1}/>)}</g><path class="art-path" d="M225 155H290 Q325 155 335 120 L370 75 M290 155H375 M290 155Q325 155 335 190L370 235" stroke="var(--accent)" fill="none" stroke-width="1.5"/><g fill="var(--art-panel)" stroke="var(--accent)"><rect x="370" y="54" width="138" height="43" rx="4"/><rect x="375" y="134" width="138" height="43" rx="4"/><rect x="370" y="214" width="138" height="43" rx="4"/></g><g fill="currentColor" font-size="13" font-family="monospace"><text x="394" y="80">AUDIO SIGNAL</text><text x="399" y="160">PATIENT BAGS</text><text x="394" y="240">ATTENTION MIL</text></g></svg>}
  {slug === 'parallel-computing' && <div class="parallel-graphic"><div class="parallel-workload"><span>COUNT GLIDERS</span><i></i><b>OPENMP ↔ CUDA</b></div><div class="parallel-workload"><span>HISTOGRAM</span><i></i><b>OPENMP ↔ CUDA</b></div><div class="parallel-workload"><span>EMBOSS</span><i></i><b>OPENMP ↔ CUDA</b></div><span class="graphic-footnote mono">SUPPLIED CPU REFERENCES · END-TO-END TIMING</span></div>}
  {slug === 'recola' && <svg viewBox="0 0 600 310" class="art-svg map-art"><g stroke="currentColor" stroke-opacity=".08" fill="none" stroke-width="22"><path d="M0 60 260 100 430 0M0 260 210 200 600 245M130 0 160 310M400 0 370 310M0 145 600 145M520 0 490 310"/></g><path d="M160 245V145H386V87" stroke="var(--accent)" stroke-width="2" fill="none" stroke-dasharray="5 6" class="art-path"/><g fill="var(--accent)"><circle cx="160" cy="245" r="7"/><circle cx="386" cy="87" r="7"/><circle cx="386" cy="87" r="19" fill-opacity=".15"/></g><g transform="translate(203 108)"><rect width="152" height="82" rx="7" fill="var(--art-panel)" stroke="var(--art-stroke)"/><text x="17" y="32" fill="currentColor" font-size="17" font-family="sans-serif">Property A</text><text x="17" y="58" fill="var(--accent)" font-size="12" font-family="monospace">MAP ↔ PROPERTY</text></g><text x="25" y="287" fill="var(--art-muted)" font-size="11" font-family="monospace">WORKFLOW SCHEMATIC · FICTIONAL LOCATION</text></svg>}
  {slug === 'heston' && <div class="heston-pipeline"><div class="heston-stage"><span>INPUT</span><strong>93 OTM<br/>SPX contracts</strong></div><span class="heston-arrow">→</span><div class="heston-stage"><span>PRICING</span><strong>CPU COS<br/>CuPy GPU</strong></div><span class="heston-arrow">→</span><div class="heston-stage"><span>APPROXIMATION</span><strong>10D neural<br/>surrogate</strong></div><p class="mono">ILLUSTRATIVE PIPELINE · NOT MARKET DATA</p></div>}
  {slug === 'speech-technology' && <svg viewBox="0 0 600 310" class="art-svg"><rect x="181" y="62" width="141" height="181" fill="var(--accent)" fill-opacity=".065"/><rect x="388" y="62" width="90" height="181" fill="var(--accent)" fill-opacity=".065"/><path d="M40 155h520" stroke="currentColor" stroke-opacity=".13"/><g stroke="var(--accent)" stroke-width="2.4" class="wave-bars">{wave.map((height,index) => <path d={`M${42+index*6.9} ${155-height}v${height*2}`}/>)}</g><path class="art-path" d="M40 268h140v-20h141v20h67v-20h90v20h82" fill="none" stroke="currentColor" stroke-opacity=".6"/><g fill="var(--art-muted)" font-family="monospace" font-size="11"><text x="40" y="32">SYNTHETIC SIGNAL</text><text x="40" y="296">SILENCE</text><text x="215" y="296">SPEECH</text><text x="402" y="296">SPEECH</text></g></svg>}
  {slug === 'productiv' && <div class="productiv-architecture"><div class="productiv-lanes"><div class="productiv-role"><span>PUBLIC</span><strong>Landing / posts</strong></div><div class="productiv-role"><span>SUBSCRIBER</span><strong>Tasks / projects</strong></div><div class="productiv-role"><span>REPORTER</span><strong>Analytics</strong></div><div class="productiv-role"><span>ADMIN</span><strong>Moderation</strong></div></div><div class="productiv-core"><span class="mono">SHARED DOMAIN SERVICES</span><strong>Teams · assignments · notifications</strong><small>Focus support · gamification · reporting</small></div><span class="productiv-architecture-note mono">ILLUSTRATIVE ARCHITECTURE · TEAM PROJECT</span></div>}
  <div class="art-bottomline mono"><span>{slug === 'parallel-computing' ? 'OPENMP / CUDA' : slug === 'productiv' ? 'ROLE / TASK ARCHITECTURE' : 'SYSTEM STUDY'}</span><span>{slug === 'productiv' ? 'ILLUSTRATIVE SCHEMATIC' : 'ARYAN LOKESH'}</span></div>
</div>
