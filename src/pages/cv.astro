---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { projects } from '../data/projects';
---
<Layout title="CV — Aryan Lokesh" description="Aryan Lokesh’s CV: education, software and AI projects, technical skills and contact details.">
  <div class="container cv-container">
    <section class="page-heading"><p class="eyebrow" data-reveal>CURRICULUM VITAE</p><h1 data-reveal>Education, projects,<br/><span class="accent-text">technical skills.</span></h1><div class="cv-download" data-reveal><a class="button button-primary" href="/cv/aryan-lokesh-cv.pdf" download data-astro-reload>Download CV <span aria-hidden="true">↓</span></a><span class="mono muted">PDF · ONE PAGE</span></div></section>
    <div class="cv-sheet"><header><h2>Aryan Lokesh</h2><p>Graduate Software & AI Engineer · United Kingdom</p><div class="cv-contact"><a href="mailto:aryan.lokesh4@gmail.com">Email ↗</a><a href="https://github.com/Aio777" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/aryan-l-4516562b4/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></header><section><h3>Education</h3><strong>University of Sheffield · 2022–2026</strong><p>MComp Computer Science with Artificial Intelligence — four-year integrated master’s, 2:1.<br/>Final-year average: 70.1%.</p></section><section><h3>Selected projects</h3><div class="cv-projects">{projects.map(project => <a href={`/work/${project.slug}/`}><div><strong>{project.subtitle}</strong><span>{project.role}</span><p>{project.description}</p></div><Arrow diagonal/></a>)}</div></section><section><h3>Technical skills</h3><p>Python · C/C++ · Kotlin · Ruby · SQL<br/>PyTorch · Rails · PostgreSQL · CUDA / OpenMP · Jetpack Compose · Git · Linux</p></section></div>
  </div>
</Layout>
