---
import Layout from '../../layouts/Layout.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import Benchmark from '../../components/Benchmark.astro';
import Arrow from '../../components/Arrow.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() { return projects.map((project,index) => ({ params: { slug: project.slug }, props: { project, next: projects[(index + 1) % projects.length] } })); }
const { project, next } = Astro.props;
const resultsHeading = project.category === 'Software' ? 'Project scope' : 'Results';
---
<Layout title={`${project.subtitle} — Aryan Lokesh`} description={project.description}>
  <article class="case-study container">
    <a class="case-back mono" href="/work/">← ALL WORK</a>
    <header class="case-heading"><p class="eyebrow" data-reveal>{project.number} / {project.category} / {project.period}</p><h1 transition:name={`title-${project.slug}`}>{project.title}</h1><p class="case-subtitle">{project.subtitle}</p><div class="case-meta"><div><span class="mono muted">CONTRIBUTION</span><p>{project.role}</p></div><div><span class="mono muted">BUILT WITH</span><div class="tags">{project.technologies.map(technology => <span>{technology}</span>)}</div></div>{project.repo && <a class="text-link" href={project.repo} target="_blank" rel="noopener noreferrer">View source <Arrow diagonal/></a>}</div></header>
    <div class="case-visual" transition:name={`art-${project.slug}`}><ProjectArt slug={project.slug} large/></div>
    <div class="case-body">
      <aside class="case-sidebar"><p class="eyebrow">CONTENTS</p><nav aria-label="Case study sections"><a href="#the-problem">Scope</a><a href="#the-approach">Implementation</a><a href="#the-results">{resultsHeading}</a></nav></aside>
      <div class="case-content">
        <section id="the-problem" class="case-section" data-reveal><p class="eyebrow">01 / SCOPE</p><h2>Problem and<br/>scope.</h2><p class="lead-copy">{project.problem}</p><div class="role-note"><span class="mono">{project.slug === 'productiv' ? 'TEAM PROJECT' : 'MY ROLE'}</span><p>{project.roleDetail}</p></div></section>
        <section id="the-approach" class="case-section"><div data-reveal><p class="eyebrow">02 / IMPLEMENTATION</p><h2>Implementation<br/>details.</h2></div><ol class="architecture-flow" aria-label="Project architecture">{project.approach.map((step,index) => <li data-reveal><span class="mono">0{index + 1}</span><strong>{step}</strong>{index < project.approach.length - 1 && <span class="flow-arrow" aria-hidden="true">↓</span>}</li>)}</ol><div class="decision-list">{project.decisions.map((decision,index) => <div class="decision" data-reveal><span class="mono decision-number">0{index + 1}</span><div><h3>{decision.title}</h3><p>{decision.text}</p></div></div>)}</div></section>
        <section id="the-results" class="case-section"><div data-reveal><p class="eyebrow">03 / {resultsHeading.toUpperCase()}</p><h2>{resultsHeading}.</h2></div>{project.slug === 'parallel-computing' ? <Benchmark/> : <div class="result-grid">{project.results.map(result => <div class="result-stat" data-reveal><strong>{result.value}</strong><span>{result.label}</span></div>)}</div>}<p class="result-note">{project.resultNote}</p><details class="limitations"><summary>Context & limitations <span aria-hidden="true">+</span></summary><p>{project.limitations}</p></details></section>
      </div>
    </div>
    <a class="next-project" href={`/work/${next.slug}/`}><div><span class="eyebrow">NEXT PROJECT / {next.number}</span><h2>{next.title}</h2><p>{next.subtitle}</p></div><span class="next-arrow"><Arrow/></span></a>
  </article>
</Layout>
