---
import Layout from '../layouts/Layout.astro';
import Orbital from '../components/Orbital.astro';
import Arrow from '../components/Arrow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---
<Layout>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow" data-hero-kicker><span class="accent-line"></span>GRADUATE SOFTWARE & AI ENGINEER</p>
      <h1 class="hero-title"><span class="line"><span>Software engineer.</span></span><span class="line"><span class="accent-text">Applications, models, systems.</span></span></h1>
      <p class="hero-description" data-hero-detail>MComp graduate working across software applications, machine learning and performance code.</p>
      <div class="hero-ctas" data-hero-detail><a class="button button-primary" href="#selected-work">Selected work <Arrow/></a><a class="text-link" href="/cv/aryan-lokesh-cv.pdf" download data-astro-reload>Download CV <span aria-hidden="true">↓</span></a></div>
      <div class="hero-credentials" data-hero-detail><span class="mono">BASED IN THE UK</span><span class="credential-divider"></span><span>MComp Computer Science with AI<br/><span class="muted">4-year integrated master’s · University of Sheffield</span></span></div>
    </div>
    <div class="hero-visual" data-hero-visual><Orbital/></div>
      <div class="hero-bottom mono"><span>SOFTWARE / ML / SYSTEMS</span><a href="#selected-work">VIEW SELECTED WORK <span aria-hidden="true">↓</span></a></div>
  </section>
  <div class="discipline-strip" aria-label="Focus areas"><div class="container"><span>Applications</span><span class="strip-star" aria-hidden="true">✳</span><span>Machine learning</span><span class="strip-star" aria-hidden="true">✳</span><span>Performance code</span><span class="strip-star" aria-hidden="true">✳</span></div></div>
  <section class="section container" id="selected-work">
    <div class="section-heading" data-reveal><div><p class="eyebrow">01 / SELECTED WORK</p><h2>Selected<br/><span class="muted">work.</span></h2></div><p class="section-intro">Projects across Android, Rails, audio ML, GPU computing, speech technology and numerical pricing.</p></div>
    <div class="project-grid">{projects.slice(0,4).map(project => <ProjectCard project={project}/>)}</div>
    <div class="more-work"><span class="mono">PROJECT INDEX</span><a class="text-link" href="/work/">View all projects <Arrow/></a></div>
  </section>
  <section class="about-section"><div class="container about-grid"><div data-reveal><p class="eyebrow">02 / PROFILE</p><h2>Software, models,<br/><span class="accent-text">implementation and evidence.</span></h2></div><div class="about-copy" data-reveal><p>I care about what has to work between the diagram and the result: the data, the interface, the runtime and the evidence.</p><p class="muted">I’m a 2026 MComp graduate from Sheffield. My work includes Android and Rails applications, audio models, CUDA/OpenMP implementations and numerical pricing systems.</p><a href="/about/" class="text-link">Profile <Arrow/></a><div class="about-facts"><div><strong>MComp</strong><span>Computer Science with AI</span></div><div><strong>2026</strong><span>University of Sheffield</span></div></div></div></div></section>
  <section class="contact-section container" id="contact"><div data-reveal><p class="eyebrow">03 / CONTACT</p><h2>Contact.</h2><p>I’m applying for graduate software engineering and applied ML roles. Email is the quickest way to reach me.</p><a href="mailto:aryan.lokesh4@gmail.com" class="contact-email">aryan.lokesh4@gmail.com <Arrow diagonal/></a><div class="contact-links"><a href="https://github.com/Aio777" target="_blank" rel="noopener noreferrer">GitHub <Arrow diagonal/></a><a href="https://www.linkedin.com/in/aryan-l-4516562b4/" target="_blank" rel="noopener noreferrer">LinkedIn <Arrow diagonal/></a><a href="/cv/">View CV <Arrow diagonal/></a></div></div><span class="contact-asterisk" aria-hidden="true">✳</span></section>
</Layout>
